# Stellar Cyber configuration
STELLAR_HOST=your-stellar-host
STELLAR_REFRESH_TOKEN=replace-with-your-token
STELLAR_VERIFY_TLS=true

# HTTP request configuration (seconds, applies to Stellar and destination)
REQUEST_TIMEOUT=30

# Destination configuration
DESTINATION_API_URL=https://your-api.example.com/events
API_KEY=replace-with-your-basic-auth-credential
SENSOR_ID=replace-with-sensor-id

# Logging
LOG_FILE=log.txt
# false disables all console and file logging
LOG_ENABLED=true
# DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO
# Toggle HTTP request and response logging of forwarded events independently
LOG_REQUEST=true
LOG_RESPONSE=true
# Rotate the log at midnight into LOG_FILE.YYYY-MM-DD and keep this many days
# (0 = keep every rotated file)
LOG_RETENTION_DAYS=7

# Forward statistics, persisted so counts survive log cleanup.
# Counts unique events: records re-sent by a retried window are not counted twice.
STATS_ENABLED=true
STATS_FILE=stats.json
# Days of per-day counters to keep in STATS_FILE
STATS_RETENTION_DAYS=30

# Scheduler
RUN_INTERVAL_MINUTES=5
# First run window start: either an ISO 8601 timestamp ...
INITIAL_START_TIME=
# ... or a lookback (minutes before now). Defaults to RUN_INTERVAL_MINUTES.
INITIAL_LOOKBACK_MINUTES=
# true = query/forward once then exit (useful for cron / manual test)
RUN_ONCE=false

# Stellar query timezone offset, also used to format the timestamp range
SEARCH_TIME_ZONE=+07:00
